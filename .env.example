# ============================================================
# Comercial Fênix — variáveis de ambiente
# Copie para .env.local (desenvolvimento) e cadastre todas na Vercel
# (Project → Settings → Environment Variables). Nunca versione .env.local.
# ============================================================

# URL pública do site (sem barra no final). Usada em SEO, sitemap e e-mails.
NEXT_PUBLIC_SITE_URL=https://www.hospitalaresfenix.com.br

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (anon/publishable). Segura no navegador: o RLS restringe o acesso.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de serviço: SOMENTE no servidor (nunca com prefixo NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (e-mails transacionais) ---
RESEND_API_KEY=
# Remetente em domínio verificado na Resend (SPF/DKIM/DMARC configurados)
EMAIL_FROM="Comercial Fênix <contato@hospitalaresfenix.com.br>"
# Para onde vão as notificações de novos leads
EMAIL_NOTIFICACAO=fenix.hospitalares@gmail.com

# --- Cloudflare Turnstile (anti-robô do formulário) ---
# Em desenvolvimento, as chaves de teste abaixo sempre passam:
#   site: 1x00000000000000000000AA   secret: 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Upstash Redis (limite de requisições e bloqueio de login) ---
# A integração Upstash da Vercel cria KV_REST_API_URL e KV_REST_API_TOKEN:
# esses nomes também são aceitos, sem precisar duplicar.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
